# All values are optional; these are the defaults.
PORT=3000
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=ingest

# Simulated external system
EXTERNAL_DELAY_MS=5000
EXTERNAL_FAILURE_RATE=0
MAX_OUTBOUND_CONCURRENCY=200

# Worker
WORKER_SLOTS=100
MAX_BATCH=50
POLL_INTERVAL_MS=150
LEASE_MS=30000
HEARTBEAT_MS=10000
REAPER_INTERVAL_MS=5000

# Retries
MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
MAX_FOLD_RETRIES=3
